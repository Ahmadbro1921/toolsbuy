# ==============================================================================
# AI Hub — Environment Configuration Template
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Free Tier available at supabase.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Initial Administrator Setup (CLI / script only, never client-side)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@aihub.local
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini, OpenAI, or Mock)
# ------------------------------------------------------------------------------
# Provider options: "gemini" | "openai" | "mock"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Transactional Email Provider (Resend or Mock logger)
# ------------------------------------------------------------------------------
# Provider options: "resend" | "mock"
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=AI Hub <notifications@aihub.local>
ADMIN_NOTIFICATION_EMAIL=admin@aihub.local

# ------------------------------------------------------------------------------
# Site Security & Settings
# ------------------------------------------------------------------------------
CRON_SECRET=generate_a_random_32_char_hex_for_scheduled_jobs
NEXT_PUBLIC_SITE_NAME="AI Hub"
NEXT_PUBLIC_SITE_DESCRIPTION="Discover, compare, and leverage the most powerful AI tools."
